    {
      "title": "The Case on Salesforce Stock (CRM)",
      "fund": "r/ValueInvesting",
      "date": "June 2026",
      "summary": "Analyzes Salesforce as a highly cash-generative value play trading at ~3.7x EV/Sales and ~18x trailing earnings following market concerns over decelerating organic growth. The post highlights the company's $14.4B in annual free cash flow, aggressive $25B share repurchase authorization, and unpriced optionality in Agentforce, while cautioning against debt additions and M&A-flattered top-line metrics.",
      "url": "https://www.reddit.com/r/ValueInvesting/search/?q=CRM&restrict_sr=1&sort=top",
      "btn_label": "Reddit DDs \u2197"
    },
    {
      "title": "Salesforce is looking interesting on a DCF basis, but the entire bull case hinges on one number. Anyone else digging into this?",
      "fund": "r/ValueInvesting",
      "date": "March 2026",
      "summary": "Presents a rigorous discounted cash flow valuation indicating an intrinsic value of $320 per share (~65% upside) relative to a $195 market price at an 8% FCF yield. The author demonstrates that while 10% top-line growth is reasonable, the bull thesis completely depends on whether EBITDA margins can expand from current 31% levels toward analyst consensus targets of 49%. Operational execution on efficiency serves as the single critical catalyst for valuation realization.",
      "url": "https://www.reddit.com/r/ValueInvesting/search/?q=CRM&restrict_sr=1&sort=top",
      "btn_label": "Reddit DDs \u2197"
    },
    {
      "title": "The Salesforce ($CRM) Thesis Has Changed. The Opportunity Hasn't.",
      "fund": "Substack / Summit Stocks",
      "date": "June 2026",
      "summary": "Evaluates Salesforce's structural pivot from seat-based CRM compounder to an agentic AI platform play powered by Agentforce and Data 360. While core legacy application growth has moderated to ~7%, the author highlights accelerating traction in Data 360 (+23% YoY) and Agentforce ARR, backed by high enterprise switching costs and a $50 billion buyback program.",
      "url": "https://summitstocks.substack.com/p/the-salesforce-crm-thesis-has-changed",
      "btn_label": "Substack Memo \u2197"
    },
    {
      "title": "Salesforce, Inc. \u2013 The sell-off presents an opportunity. I am buying.",
      "fund": "Substack / Rijnberk InvestInsights",
      "date": "June 2024",
      "summary": "Frames a post-earnings sell-off as a compelling entry point into a wide-moat SaaS leader trading at ~22x forward earnings. The thesis outlines clear catalysts around margin expansion, free cash flow conversion, and market share gains, supported by a low 16% payout ratio that underwrites strong dividend growth potential.",
      "url": "https://substack.com/@investinsights",
      "btn_label": "Substack Memo \u2197"
