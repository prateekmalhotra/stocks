  "researched_writeups": [
    {
      "title": "ANALYSIS: Adobe (ADBE)",
      "fund": "Substack / The Tortoisehare (Isaac Aydelman)",
      "date": "January 08, 2026",
      "summary": "The author argues that Adobe is trading at a decade-low multiple (56% below its 2017\u20132024 median P/E) due to misplaced AI disruption fears . A reverse DCF shows the market is pricing in just a 4% 5-year revenue CAGR despite management guiding to 10% growth and underlying end-markets expanding toward a $293 billion TAM by 2027. Key operational catalysts include enterprise generative AI monetization via Firefly and Acrobat AI Assistant, robust 35%+ operating margins, and expanding Generative Engine Optimization (GEO) capabilities.",
      "url": "https://tortoisehare.substack.com/p/analysis-adobe-adbe",
      "btn_label": "Substack Memo \u2197"
    },
    {
      "title": "Adobe is down 40% from its highs while generating $8.25B in true annual FCF with 10% topline growth. I think it died of a theory, not an actual threat. Here's the data including deferred revenue, government contract data from USASpending.gov, and a bear case.",
      "fund": "r/ValueInvesting",
      "date": "July 13, 2026",
      "summary": "This data-driven pitch refutes the market's 'AI replaces SaaS' narrative by presenting Adobe's resilient underlying cash flows, including $8.25B in true annual FCF (a ~9.3% true FCF yield adjusting for stock-based compensation). The author highlights a 229% positive swing in Q2 deferred revenue as enterprise clients extend contract lengths rather than churn. Furthermore, federal procurement tracking via USASpending.gov reveals deep institutional reliance on Creative Cloud and Acrobat, confirming Adobe's workflow lock-in remains intact.",
      "url": "https://www.reddit.com/r/ValueInvesting/search/?q=ADBE&restrict_sr=1&sort=top",
      "btn_label": "Reddit DDs \u2197"
    },
    {
      "title": "Adobe (ADBE) Investment Thesis",
      "fund": "r/ValueInvesting",
      "date": "January 28, 2026",
      "summary": "The thesis demonstrates that generative AI is an enterprise tailwind rather than an existential threat because professional creators and corporations require legal indemnification, proprietary file formats (.ai, .psd, .pdf), and integrated creative pipelines. Unit economics indicate a new entrant would need to spend over $30 billion across five years in cumulative R&D and S&M to build a comparable enterprise suite. Valuation math yields a base-case intrinsic value of $431.97 per share (~45% upside) underpinned by 35%+ operating margins, high capital efficiency, and aggressive share repurchases.",
      "url": "https://www.reddit.com/r/ValueInvesting/search/?q=ADBE&restrict_sr=1&sort=top",
      "btn_label": "Reddit DDs \u2197"
    },
    {
      "title": "Adobe ($ADBE): The Market Is Missing The Bigger Picture",
      "fund": "Substack / Summit Stocks (Lucas)",
      "date": "June 15, 2026",
      "summary": "The write-up analyzes Adobe's Q2 FY2026 earnings ($6.62 billion revenue, up 13% YoY) to show that Firefly AI features are enhancing retention and driving top-line acceleration rather than cannibalizing seat counts. With an ecosystem of over 850 million monthly active users, Adobe possesses an insurmountable distribution moat that allows it to seamlessly monetize AI tools across its existing subscriber base. High workflow switching costs across Creative Cloud and Digital Experience, paired with massive cash generation funding stock buybacks, support a strong long-term compounding narrative.",
      "url": "https://summitstocks.substack.com/archive?sort=search&search=ADBE",
      "btn_label": "Substack Memo \u2197"
    }
