    {
      "title": "Booking Holdings \u2013 The Only Travel Stock You Need (and should want) to Own!",
      "fund": "Substack / Rijnberk InvestInsights",
      "date": "November 2025",
      "summary": "Evaluates Booking Holdings as a structurally advantaged compounding machine generating over $8 billion in annual free cash flow at a 38% FCF margin . Highlights how unmatched global scale and network effects allow BKNG to continuously gain market share over Airbnb and Expedia while retiring 21% of outstanding shares over two years. Emphasizes the 'Connected Trip' ecosystem and low-to-mid-teens revenue growth as core catalysts driving mid-5% FCF yields and sustainable EPS compounding.",
      "url": "https://rijnberk.substack.com/p/booking-holdings-the-only-travel"
    },
    {
      "title": "AI won't kill Booking - it might make it stronger",
      "fund": "r/ValueInvesting",
      "date": "May 2026",
      "summary": "Rebuts GenAI disruption fears by demonstrating that large language models lack the payment clearing flow, customer service infrastructure, and direct hotel integration necessary to bypass OTAs. Details how direct app bookings now represent over 50% of total volume, significantly reducing marketing reliance on Google search. Models strong earnings momentum fueled by double-digit historical revenue CAGR, high merchant float utilization, and disciplined share repurchases.",
      "url": "https://www.reddit.com/r/ValueInvesting/comments/1ck0u7q/ai_wont_kill_booking_it_might_make_it_stronger/"
    },
    {
      "title": "Booking Holdings (BKNG) Pitch",
      "fund": "Value Investors Club (VIC) / Gandalf",
      "date": "March 2026",
      "summary": "Frames Booking as a premier global compounder converting 25% of revenue into free cash flow with virtually no leverage (0.3x Net Debt/EBITDA). Argues that AI panic created an unwarranted 25%+ valuation drawdown down to ~15-17x forward earnings despite 65% of room nights being booked directly on the app by loyal users. Projects over 75% upside in 2-3 years assuming a mean-reverting 20x terminal multiple on Street EPS estimates alongside 5% annual float reduction.",
      "url": "https://valueinvestorsclub.com/idea/BOOKING_HOLDINGS_INC/222384"
    },
    {
      "title": "Booking Holdings: Leading Travel or Facing Disruption?",
      "fund": "Substack / Daniel's Deep Dive",
      "date": "March 2026",
      "summary": "Analyzes Booking's moat in European and Asian long-tail hotel supply, where heavy market fragmentation prevents AI agents or hotel chains from disintermediating the platform. Explains how internal GenAI tools have reduced customer service cost per booking by ~10% while optimizing search filters and trip planning. Highlights the company's capital allocation efficiency and expanding merchant payment depth as key drivers for high-single-digit booking growth and superior ROIC.",
      "url": "https://danielsdeepdive.substack.com/p/booking-holdings-leading-travel-or"
    }
